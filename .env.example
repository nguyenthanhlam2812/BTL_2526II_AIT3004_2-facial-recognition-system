APP_NAME=AI Facial Recognition Backend
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=face_attendance
MYSQL_USER=app
MYSQL_PASSWORD=app_password
MYSQL_ROOT_PASSWORD=root_password

REDIS_URL=redis://127.0.0.1:6379/0
ENROLLMENT_QUEUE=enrollment
RATE_LIMIT_STORAGE_URI=memory://
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=10
REDIS_SOCKET_TIMEOUT_SECONDS=600
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
RQ_WORKER_TTL_SECONDS=420

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_ENROLLMENTS=enrollments
MINIO_BUCKET_SNAPSHOTS=snapshots

QDRANT_URL=http://127.0.0.1:6333
ATTENDANCE_THRESHOLD=0.3
INSIGHTFACE_MODEL_NAME=buffalo_l
QDRANT_COLLECTION_EMPLOYEE_FACES=employee_faces
FACE_MIN_DET_SCORE=0.5
FACE_MIN_AREA_RATIO=0.015
FACE_SECONDARY_AREA_RATIO=0.35
WARMUP_FACE_MODEL=true

BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
PUBLIC_DEMO_MODE=false
KIOSK_API_TOKEN=local-kiosk-token

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
