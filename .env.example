APP_NAME=AI Facial Recognition Backend
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=face_attendance
MYSQL_USER=app
MYSQL_PASSWORD=app_password
MYSQL_ROOT_PASSWORD=root_password

REDIS_URL=redis://127.0.0.1:6379/0
ENROLLMENT_QUEUE=enrollment

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_ENROLLMENTS=enrollments
MINIO_BUCKET_SNAPSHOTS=snapshots

QDRANT_URL=http://127.0.0.1:6333
ATTENDANCE_THRESHOLD=0.4
INSIGHTFACE_MODEL_NAME=buffalo_l
QDRANT_COLLECTION_EMPLOYEE_FACES=employee_faces


JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

